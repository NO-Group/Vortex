# ── Vortex Deploy Secrets ────────────────────────────────────────────────────
# This file holds real credentials that must NOT be committed to Git.
# Copy to secrets.env and fill in:
#   cp scripts/secrets.env.example scripts/secrets.env
# Then edit values below.
#
# scripts/deploy.sh sources this file automatically — no manual .env editing
# needed during deploy. secret.env is gitignored and stays on the VPS only.

# Cloudflare R2
R2_ACCOUNT_ID=
R2_BUCKET=vortex
R2_ACCESS_KEY=
R2_SECRET_KEY=

# SMTP (Resend)
SMTP_HOST=smtp.resend.com
SMTP_USER=resend
SMTP_PASS=

# Paystack (secret key from dashboard.paystack.com — never in frontend)
PAYSTACK_SECRET_KEY=

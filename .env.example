# ── Vortex Server Configuration ───────────────────────────────────────────────
# Copy to .env and adjust. Never commit real secrets.

# HTTP
PORT=8080
HOST=0.0.0.0
CORS_ORIGINS=*

# PostgreSQL (docker-compose default credentials)
DATABASE_URL=postgres://vortex:vortex@localhost:5432/vortex

# Auth
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=1h
JWT_ISSUER=vortex

# Run knex migrations automatically on boot (convenient for dev / docker)
AUTO_MIGRATE=true

# ── Storage Gateway ───────────────────────────────────────────────────────────
# driver: "local" (disk fallback) | "s3" (AWS S3 / Cloudflare R2 / MinIO)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.vortex-data
# Absolute base used when presigning URLs returned to clients
PUBLIC_API_BASE=http://localhost:8080

# S3-compatible endpoint settings (used when STORAGE_DRIVER=s3)
S3_BUCKET=vortex
S3_REGION=auto
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=vortex
S3_SECRET_ACCESS_KEY=vortex-secret
S3_FORCE_PATH_STYLE=true

# ── Realtime Engine ───────────────────────────────────────────────────────────
REALTIME_HEARTBEAT_MS=30000

# Optional: Redis URL enabling the multi-node fan-out bridge. When set,
# a cluster of Vortex engines sharing this Redis acts as one realtime fabric.
# REDIS_URL=redis://localhost:6379

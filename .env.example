# ── Vortex Server Configuration ───────────────────────────────────────────────
# Copy to .env and adjust. Never commit real secrets.
# For production deployment: see docs/DEPLOY.md

# HTTP
PORT=8080
HOST=0.0.0.0
# In production set this to your real origins (comma-separated)
CORS_ORIGINS=https://vortex.no-group.org,http://localhost:8080

# PostgreSQL (docker-compose default credentials)
DATABASE_URL=postgres://vortex:vortex@localhost:5432/vortex

# Auth — MUST be a long random string in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=1h
JWT_ISSUER=vortex

# Encryption — used for encrypting data at rest:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Shield — security shield secret key:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SHIELD_SECRET_KEY=dev-shield-key-change-me

# Run knex migrations automatically on boot (convenient for dev / docker)
AUTO_MIGRATE=true

# ── Console (served by the engine at / for single-process deploys) ───────────
SERVE_CONSOLE=true
# Absolute origin used in email links (your public URL)
PUBLIC_APP_URL=https://vortex.no-group.org

# ── Email (magic links + password resets) ────────────────────────────────────
# SMTP connection string, e.g. smtps://user:pass@smtp.host:465
# Providers with SMTP: Brevo, Mailgun, Resend, Postmark, Amazon SES.
# Without SMTP, set VORTEX_DEV_LINKS=true (dev only!) so links come back inline.
# SMTP_URL=smtps://resend:YOUR_RESEND_API_KEY@smtp.resend.com:465
SMTP_URL=
MAIL_FROM=Vortex <no-reply@no-group.org>
# VORTEX_DEV_LINKS=true

# ── Storage Gateway ───────────────────────────────────────────────────────────
# driver: "s3" (Cloudflare R2 / AWS S3) | "local" (disk fallback)
# Vortex uses Cloudflare R2 for zero egress fees in production.
STORAGE_DRIVER=s3
# Fallback to local disk if R2 is unreachable
STORAGE_FALLBACK_DRIVER=local
STORAGE_LOCAL_DIR=./.vortex-data
# Absolute base used when presigning URLs returned to clients ("auto" derives
# it from each request — recommended behind proxies and for previews)
PUBLIC_API_BASE=auto

# ── Cloudflare R2 (S3-compatible endpoint) ────────────────────────────────────
# Account ID + API token from Cloudflare: Workers & Storage > R2 > Buckets
# > Manage > API Tokens. Create a token with R2 admin permissions.
# Production: scripts/deploy.sh sources scripts/secrets.env (gitignored)
# and sets these automatically. For local dev, set them here:
S3_BUCKET=vortex
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ── Realtime Engine ───────────────────────────────────────────────────────────
REALTIME_HEARTBEAT_MS=30000

# ── Push Notifications (v0.9) ───────────────────────────────────────────────
# Web Push (VAPID) — browser-native push. Works in Chrome, Firefox, Edge, Safari.
# No external setup needed. Keys auto-generate if not set, but you should
# persist them so browser subscriptions don't break on restart.
# Generate: node -e "const wp=require('web-push');console.log(JSON.stringify(wp.generateVAPIDKeys()))"
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=noreply@vortex.local
#
# FCM HTTP v1 — for Android apps using Firebase Cloud Messaging.
# Requires a Firebase project with a service account.
# Get from: console.firebase.google.com > Project Settings > Service Accounts > Generate private key
# FCM_PROJECT_ID=your-firebase-project-id
# FCM_PRIVATE_KEY=your-service-account-private-key-pem
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
#
# APNs — for native iOS apps. This is the ONLY push channel that works on
# iOS. Requires an Apple Developer account with push notifications enabled.
# Get these from Apple Developer > Keys > create a key with "Apple Push
# Notification service (APNs)" enabled, then download the .p8 file.
# APNS_TEAM_ID=ABC1234567
# APNS_KEY_ID=ABC1234567
# APNS_BUNDLE_ID=com.example.app
# APNS_PRIVATE_KEY=base64-encoded-p8-key-contents
# APNS_SANDBOX=false
#
# Legacy FCM server key (deprecated — use FCM HTTP v1 above instead)
# FCM_SERVER_KEY=

# ── Multi-Node ───────────────────────────────────────────────────────────────
# A cluster of Vortex engines sharing this Redis acts as one realtime fabric.
# REDIS_URL=redis://localhost:6379

# ── Query Governance (v0.7) ──────────────────────────────────────────────────
# Cost ceiling: every /v1/db query is EXPLAINed before execution and
# rejected past this cost — the guardrail Supabase doesn't have.
# Leave unset for no ceiling.
# MAX_QUERY_COST=1000
# Log queries at or above this duration (ms) to the audit table.
SLOW_QUERY_MS=250
# Per-channel realtime backlog depth for reconnect replay.
REALTIME_BACKLOG=500

# ── Edge Cache (v0.9) ────────────────────────────────────────────────────────
# TTL for cached responses (seconds)
EDGE_CACHE_TTL=300
# Max cache entries (auto-evicts oldest when full)
EDGE_CACHE_MAX_ENTRIES=10000

# ── Paystack ─────────────────────────────────────────────────────────────────
# Public key from: dashboard.paystack.com > Settings > Developer
# Secret key from: dashboard.paystack.com > Settings > Developer (never expose
# to frontend — keep server-side only)
PAYSTACK_PUBLIC_KEY=pk_live_1d48c7981d1abf7396474499a369ab7bef17740a
PAYSTACK_SECRET_KEY=

# ── Super Admin Bypass ──────────────────────────────────────────────────────
# Email that always has admin access, bypassing any paywall or role check.
# Set during deploy — n.ogroup@yahoo.com is the owner's super admin.
VORTEX_SUPER_ADMIN=n.ogroup@yahoo.com

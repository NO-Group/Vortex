# ── Vortex Server Configuration ───────────────────────────────────────────────
# Copy to .env and adjust. Never commit real secrets.

# HTTP
PORT=8080
HOST=0.0.0.0
# In production set this to your real origins (comma-separated), e.g.
# CORS_ORIGINS=https://vortex.example.com
CORS_ORIGINS=*

# PostgreSQL (docker-compose default credentials)
DATABASE_URL=postgres://vortex:vortex@localhost:5432/vortex

# Auth — MUST be a long random string in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=1h
JWT_ISSUER=vortex

# Run knex migrations automatically on boot (convenient for dev / docker)
AUTO_MIGRATE=true

# ── Console (served by the engine at / for single-process deploys) ───────────
SERVE_CONSOLE=true
# Absolute origin used in email links (your public URL)
PUBLIC_APP_URL=http://localhost:8080

# ── Email (magic links + password resets) ────────────────────────────────────
# SMTP connection string, e.g. smtps://user:pass@smtp.host:465
# Providers with SMTP: Brevo, Mailgun, Resend, Postmark, Amazon SES.
# Without SMTP, set VORTEX_DEV_LINKS=true (dev only!) so links come back inline.
# SMTP_URL=
MAIL_FROM=Vortex <no-reply@vortex.local>
# VORTEX_DEV_LINKS=true

# ── Storage Gateway ───────────────────────────────────────────────────────────
# driver: "local" (disk fallback) | "s3" (AWS S3 / Cloudflare R2 / MinIO)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.vortex-data
# Absolute base used when presigning URLs returned to clients ("auto" derives
# it from each request — recommended behind proxies and for previews)
PUBLIC_API_BASE=auto

# S3-compatible endpoint settings (used when STORAGE_DRIVER=s3)
S3_BUCKET=vortex
S3_REGION=auto
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=vortex
S3_SECRET_ACCESS_KEY=vortex-secret
S3_FORCE_PATH_STYLE=true

# ── Realtime Engine ───────────────────────────────────────────────────────────
REALTIME_HEARTBEAT_MS=30000

# Optional: Redis URL enabling the multi-node fan-out bridge. When set,
# a cluster of Vortex engines sharing this Redis acts as one realtime fabric.
# REDIS_URL=redis://localhost:6379

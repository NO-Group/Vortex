# ── Vortex Server Configuration ───────────────────────────────────────────────
# Copy to .env and adjust. Never commit real secrets.

# HTTP
PORT=8080
HOST=0.0.0.0
# In production set this to your real origins (comma-separated), e.g.
# CORS_ORIGINS=https://vortex.example.com
CORS_ORIGINS=*

# PostgreSQL (docker-compose default credentials)
DATABASE_URL=postgres://vortex:vortex@localhost:5432/vortex

# Auth — MUST be a long random string in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=1h
JWT_ISSUER=vortex

# Run knex migrations automatically on boot (convenient for dev / docker)
AUTO_MIGRATE=true

# ── Console (served by the engine at / for single-process deploys) ───────────
SERVE_CONSOLE=true
# Absolute origin used in email links (your public URL)
PUBLIC_APP_URL=http://localhost:8080

# ── Email (magic links + password resets) ────────────────────────────────────
# SMTP connection string, e.g. smtps://user:pass@smtp.host:465
# Providers with SMTP: Brevo, Mailgun, Resend, Postmark, Amazon SES.
# Without SMTP, set VORTEX_DEV_LINKS=true (dev only!) so links come back inline.
# SMTP_URL=
MAIL_FROM=Vortex <no-reply@vortex.local>
# VORTEX_DEV_LINKS=true

# ── Storage Gateway ───────────────────────────────────────────────────────────
# driver: "local" (disk fallback) | "s3" (AWS S3 / Cloudflare R2 / MinIO)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.vortex-data
# Absolute base used when presigning URLs returned to clients ("auto" derives
# it from each request — recommended behind proxies and for previews)
PUBLIC_API_BASE=auto

# S3-compatible endpoint settings (used when STORAGE_DRIVER=s3)
S3_BUCKET=vortex
S3_REGION=auto
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=vortex
S3_SECRET_ACCESS_KEY=vortex-secret
S3_FORCE_PATH_STYLE=true

# ── Realtime Engine ───────────────────────────────────────────────────────────
REALTIME_HEARTBEAT_MS=30000

# ── Push Notifications (v0.9) ───────────────────────────────────────────────
# Web Push (VAPID) — browser-native push. Works in Chrome, Firefox, Edge, Safari.
# No external setup needed. Keys auto-generate if not set, but you should
# persist them so browser subscriptions don't break on restart.
# Generate: node -e "const wp=require('web-push');console.log(JSON.stringify(wp.generateVAPIDKeys()))"
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=noreply@vortex.local
#
# FCM HTTP v1 — for Android apps using Firebase Cloud Messaging.
# Requires a Firebase project with a service account.
# FCM_PROJECT_ID=your-project-id
# FCM_PRIVATE_KEY=your-service-account-private-key-pem
#
# APNs — for native iOS apps. This is the ONLY push channel that works on
# iOS. Requires an Apple Developer account with push notifications enabled.
# Get these from Apple Developer > Keys > create a key with "Apple Push
# Notification service (APNs)" enabled, then download the .p8 file.
# APNS_TEAM_ID=ABC1234567
# APNS_KEY_ID=ABC1234567
# APNS_BUNDLE_ID=com.example.app
# APNS_PRIVATE_KEY=base64-encoded-p8-key-contents
# APNS_SANDBOX=false
#
# Legacy FCM server key (deprecated — use FCM HTTP v1 above instead)
# FCM_SERVER_KEY=
# a cluster of Vortex engines sharing this Redis acts as one realtime fabric.
# REDIS_URL=redis://localhost:6379

# ── Query Governance (v0.7) ──────────────────────────────────────────────────
# Cost ceiling: every /v1/db query is EXPLAINed before execution and
# rejected past this cost — the guardrail Supabase doesn't have.
# Leave unset for no ceiling.
# MAX_QUERY_COST=1000
# Log queries at or above this duration (ms) to the audit table.
SLOW_QUERY_MS=250
# Per-channel realtime backlog depth for reconnect replay.
REALTIME_BACKLOG=500

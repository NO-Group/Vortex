# ── Vortex Deploy Secrets ────────────────────────────────────────────────────
# Copy this file to secrets.env and fill in your credentials.
# secrets.env is gitignored — never commit real secrets.
# The deploy script sources this file automatically.

# Google OAuth (pre-seeded provider)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Paystack
PAYSTACK_SECRET_KEY=

# Flutterwave (optional)
FLUTTERWAVE_SECRET_KEY=

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Vortex Caddy reverse proxy (behind Cloudflare) ───────────────────────────
# Caddy handles TLS automatically (Let's Encrypt) and reverse-proxies to the
# Vortex engine on port 8080. Cloudflare sits in front for DDoS/WAF/CDN.
#
# Prerequisites:
#   1. Install Caddy: https://caddyserver.com/docs/install
#   2. Point your domain's DNS A record to this server's IP
#   3. In Cloudflare: set SSL/TLS mode to "Full" (Cloudflare → Caddy with TLS)
#   4. In Cloudflare: DNS records must show "Proxy" (orange cloud)
#   5. Place this Caddyfile at /etc/caddy/Caddyfile
#   6. caddy start (or systemctl restart caddy)
#
# Caddy auto-obtains SSL certificates. No manual cert management needed.

vortex.no-group.org {
    # Trust Cloudflare headers — get real client IP and forwarded info
    # Cloudflare sends CF-Connecting-IP with the real visitor IP
    reverse_proxy localhost:8080 {
        # Use Cloudflare's real IP header instead of the proxy's IP
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        header_up CF-Connecting-IP {remote_host}

        # Trust Cloudflare as the only proxy
        trusted_proxies static 0.0.0.0/0
    }

    # Security headers (also set at Cloudflare edge, this is the origin fallback)
    header {
        # Remove server header
        -Server
        # HSTS — force HTTPS for 1 year
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        # X-Content-Type-Options
        X-Content-Type-Options "nosniff"
        # X-Frame-Options
        X-Frame-Options "SAMEORIGIN"
        # Referrer Policy
        Referrer-Policy "strict-origin-when-cross-origin"
        # Permissions Policy — block sensitive browser features
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
    }

    # Compression
    encode zstd gzip

    # Rate limiting at the origin (Cloudflare also rate limits at the edge)
    # 100 requests per 15 seconds per IP for /v1/auth
    @auth_limit path /v1/auth/*
    limit @auth_limit {
        burst 20
        period 15s
    }

    # 500 requests per minute for general API
    @api_limit path /v1/*
    limit @api_limit {
        burst 100
        period 1m
    }

    # 20 uploads per hour per IP
    @upload_limit path /v1/storage/upload*
    limit @upload_limit {
        burst 5
        period 1h
    }

    # Logging
    log {
        output file /var/log/caddy/vortex.log
        format json
    }
}

# Optional: redirect HTTP to HTTPS (Caddy does this automatically)
# http://vortex.no-group.org {
#     redir https://vortex.no-group.org{uri}
# }
